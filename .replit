modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run build && npm run start"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 80

[env]
CLAUDE_CONFIG_DIR = "/home/runner/workspace/.local/state/claude"
PORT = "3000"
NODE_ENV = "production"
